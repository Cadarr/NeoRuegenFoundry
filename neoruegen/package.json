{
  "name": "neoruegen",
  "version": "2.0.2",
  "description": "Build tooling for the Neoruegen Foundry VTT system",
  "scripts": {
    "build": "sass src/scss/neoruegen.scss css/neoruegen.css --style=expanded --no-source-map",
    "watch": "sass src/scss/neoruegen.scss css/neoruegen.css --style=expanded --source-map --watch",
    "package": "npm run release",
    "release": "npm run build && node src/build-release.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "sass": "^1.53.0"
  }
}
