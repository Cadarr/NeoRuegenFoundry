<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'NEORUEGEN.Sheet.Character'}}"/>
      </h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="character">{{localize "NEORUEGEN.Sheet.Character"}}</a>
    <a class="item" data-tab="biography">{{localize "NEORUEGEN.Sheet.Biography"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab character" data-group="primary" data-tab="character">
      <section class="grid grid-3col">
        <aside class="sidebar">
          <h2>{{localize "NEORUEGEN.Sheet.Attributes"}}</h2>
          <div class="attributes flexcol">
            {{#each system.attributes as |attribute key|}}
            <div class="attribute flexrow flex-group-center">
              <label for="system.attributes.{{key}}.value" class="resource-label flexlarge align-left">{{localize (lookup @root.config.attributes key)}}</label>
              <input type="text" name="system.attributes.{{key}}.value" value="{{attribute.value}}" data-dtype="Number"/>
            </div>
            {{/each}}
          </div>
        </aside>

        <section class="main grid-span-2">
          <h2>{{localize "NEORUEGEN.Sheet.Skills"}}</h2>
          <div class="skills">
            {{#each skillGroups.core as |skill|}}
            <div class="skill flexrow flex-group-center">
              <label for="system.skills.{{skill.key}}.value" class="resource-label flexlarge align-left">
                <span>{{skill.label}}</span>
                <small>{{skill.attribute}}</small>
              </label>
              <input type="text" name="system.skills.{{skill.key}}.value" value="{{skill.value}}" data-dtype="Number"/>
              <button type="button" class="skill-roll" data-skill="{{skill.key}}">{{localize "NEORUEGEN.Action.Check"}}</button>
            </div>
            {{/each}}
          </div>
          <div class="skills skills-advanced">
            {{#each skillGroups.advanced as |skill|}}
            <div class="skill flexrow flex-group-center">
              <label for="system.skills.{{skill.key}}.value" class="resource-label flexlarge align-left">
                <span>{{skill.label}}</span>
                <small>{{skill.attribute}}</small>
              </label>
              <input type="text" name="system.skills.{{skill.key}}.value" value="{{skill.value}}" data-dtype="Number"/>
              <button type="button" class="skill-roll" data-skill="{{skill.key}}">{{localize "NEORUEGEN.Action.Check"}}</button>
            </div>
            {{/each}}
          </div>
        </section>
      </section>
    </div>

    <div class="tab biography" data-group="primary" data-tab="biography">
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>
  </section>
</form>
